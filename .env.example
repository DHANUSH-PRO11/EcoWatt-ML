# EcoWatt ML Environment Configuration

# Application
APP_NAME=EcoWatt ML
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration
# SQLite for local development: sqlite:///./ecowatt.db
# PostgreSQL for production: postgresql://user:password@localhost:5432/ecowatt
DATABASE_URL=sqlite:///./ecowatt.db

# ML Model settings
MODEL_DIR=ml/saved_models
DEFAULT_FORECAST_MODEL=hist_gradient_boosting
ANOMALY_CONTAMINATION=0.04
ANOMALY_SCORE_THRESHOLD=0.72

# Default Tariff configuration
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$
DEFAULT_FIXED_CHARGE=15.00
DEFAULT_TAX_RATE=0.07
DEFAULT_SURCHARGE=0.03
